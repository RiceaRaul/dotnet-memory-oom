{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Main": "<placeholder - copiaza din config-ul UAT, NU comite secrete>"
  },
  "MemoryDiagnostics": {
    "Enabled": "0",
    "IntervalSeconds": 15,
    "DumpThresholdPercent": 80,
    "DumpDirectory": "dumps",
    "DumpType": "WithHeap",
    "FallbackLimitMb": 512,
    "FailFastOnOutOfMemory": true
  }
}
